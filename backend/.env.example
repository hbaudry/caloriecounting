# Copiez en .env et renseignez vos valeurs (ne committez jamais .env).

# --- Protection de l'API (OBLIGATOIRE si exposé sur Internet) ---
# Mot de passe exigé de l'app iOS et de la page /setup.
# L'app l'envoie via l'en-tête Authorization: Bearer <mot de passe>.
CALORIE_PASSWORD=change-moi-avec-une-valeur-aleatoire

# --- Authentification Claude : choisir l'UN des deux ---
# Option A — Abonnement Claude Pro/Max (recommandé, aucun crédit API) :
#   générer le jeton sur votre ordinateur avec `claude setup-token`
#   (ou le coller via la page /setup une fois le serveur lancé).
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Option B — Crédits API (console.anthropic.com, facturation à l'usage) :
# ANTHROPIC_API_KEY=sk-ant-...

# --- Options (facultatif) ---
# Fournisseur : auto (défaut), api ou subscription.
CALORIE_PROVIDER=auto
# Modèle mode api. Défaut : claude-sonnet-5 (claude-haiku-4-5 pour réduire les coûts).
CALORIE_MODEL=claude-sonnet-5
# Modèle mode abonnement (Agent SDK) : sonnet, opus ou haiku.
CALORIE_SDK_MODEL=sonnet
# Effort de raisonnement mode api : low (défaut), medium ou high.
CALORIE_EFFORT=low
